# Microsoft Entra ID Configuration
# Copy this file to .env.local and fill in your actual values
# NEVER commit the .env.local file to version control!

# Required: Your Microsoft Entra ID Tenant ID
VITE_AZURE_TENANT_ID=YOUR_TENANT_ID

# Required: Your Microsoft Entra ID Application (Client) ID
VITE_AZURE_CLIENT_ID=YOUR_CLIENT_ID

# Optional: Custom redirect URI (defaults to <current origin>/redirect.html).
# It must point at the MSAL redirect bridge page (redirect.html).
VITE_REDIRECT_URI=http://localhost:5173/redirect.html

# Optional: Custom post-logout redirect URI (defaults to the redirect URI above).
# Popup logout lands here, so it must also be the redirect bridge page.
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/redirect.html

# Optional: API base URL (defaults to http://localhost:5137)
VITE_API_BASE_URL=http://localhost:5137