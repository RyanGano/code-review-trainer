# This project uses npm, not yarn.
#
# yarn classic delegates every command to `yarn-path` before it parses
# package.json, so this catches `yarn install`, `yarn add`, and `yarn <script>`
# with a useful message. Without it, yarn stops earlier on its own corepack
# check and reports the confusing '"packageManager": "yarn@npm@10.9.4"'.
yarn-path "./scripts/ensure-npm.cjs"
